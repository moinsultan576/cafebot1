# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it holds secrets.

# --- AI API configuration ---

# API key for the AI model provider (e.g. Anthropic)
ANTHROPIC_API_KEY=your_api_key_here

# Model name to use for chat responses
AI_MODEL=your_model_name_here

# --- Server configuration ---

# Port the backend server will run on
PORT=3000

# --- Order total configuration ---

# Tax rate as a decimal fraction, e.g. 0.08 for 8%. Leave unset for no tax.
TAX_RATE=0.08

# Flat delivery fee in dollars, applied only to delivery orders. Leave unset for no fee.
DELIVERY_FEE=2.50
